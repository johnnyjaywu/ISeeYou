--- !u!1001 &7182869
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 0}
    m_Modifications:
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: continueInput
      value: 
      objectReference: {fileID: 1025763302}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[0].text
      value: Gina?
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[1].text
      value: Elena!
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[2].text
      value: Oh my god, hi!
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[3].text
      value: It's so good to see you! How are you?
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[4].text
      value: Hi! I'm, um...
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[5].text
      value: Okay. Just tired.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[6].text
      value: "Also great! God, it\u2019s been so long."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[7].text
      value: "Yeah, It has\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[8].text
      value: "Hey, listen. I\u2019m actually grabbing lunch here. Do you wanna sit?"
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[9].text
      value: "Actually, yeah, that\u2019d be great."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[10].text
      value: "Sweet! I\u2019ll get us a table."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[11].text
      value: ...
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[13].text
      value: 'So what brings you back here? '
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[14].text
      value: Didn't you move to Seattle or something?
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[15].text
      value: "Yeah, I did. It just wasn\u2019t a fit. "
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[16].text
      value: That's okay! It happens.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[17].text
      value: And you got a job out here?
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[18].text
      value: "Yeah! I\u2019m just at the bookstore next door."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[19].text
      value: Oh, no way, I love that place!
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[20].text
      value: Anything you recommend?
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[21].text
      value: Oh, um...
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[22].text
      value: I guess it just depends on what you like.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[23].text
      value: "That\u2019s fair."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[24].text
      value: "\u2026Well, I\u2019m glad to hear you\u2019re doing well!!"
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[25].text
      value: It really is good to see you again.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[26].text
      value: "\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[27].text
      value: "Actually, um\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[28].text
      value: "I\u2019m not\u2026doing well."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[29].text
      value: "I got fired. That\u2019s why I moved back."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[30].text
      value: The bookstore is only part time.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[31].text
      value: "The only reason I\u2019m even eating out at all is\u2026"
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[32].text
      value: "Well\u2026it\u2019s my birthday."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[33].text
      value: 'Oh, my God! Happy birthday! '
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[34].text
      value: Did you have any plans?
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[35].text
      value: I wish I did.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[36].text
      value: Everyone I reached out to didn't respond.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[37].text
      value: "I\u2019m not really talking to my parents right now."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[38].text
      value: "And with the news and all, I\u2019m just too scared to go out."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[39].text
      value: This was just the one nice thing I could do for myself.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[40].text
      value: "You have no idea how alone I\u2019ve felt."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[41].text
      value: Oh, Elena...
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[42].text
      value: I'm so sorry.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[43].text
      value: "Here, I\u2019ll get your food. What did you order again?"
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[44].text
      value: You don't have to do that.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[45].text
      value: "It\u2019s your birthday! I want to."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[46].text
      value: "\u2026Thank you."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[47].text
      value: 'Of course.

'
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[48].text
      value: "You\u2019re not alone in any of this."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[49].text
      value: I think everyone is going through something right now.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[50].text
      value: "And we all just\u2026not talk about it."
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[51].text
      value: We only talk about the weather.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[52].text
      value: <i>God, why is it always the weather?!</i>
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[53].text
      value: But we should definitely do something for your birthday.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[54].text
      value: I actually know a bakery that could make you a cake. My treat.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[55].text
      value: How does that sound?
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[56].text
      value: "\u2026Yeah. That\u2019d be great. "
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[57].text
      value: Thank you.
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[58].text
      value: '[Title Drop]'
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[5].autoPlay
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 3462590240804146244, guid: 627028f9c9a2e284ca1d7096c851ba1a, type: 3}
      propertyPath: lines.Array.data[6].autoPlay
      value: 0
      objectReference: {fileID: 0}
