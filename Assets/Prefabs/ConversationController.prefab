  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4729068256503548971}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 98158282d4a0937469597bd837ae0ecf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ISeeYou::ISeeYou.ConversationController
  continueInput: {fileID: 0}
  lines:
  - text: Gina?
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Elena!
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Oh my god, hi!
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: It's so good to see you! How are you?
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Hi! I'm, um...
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Okay. Just tired.
    speakerID: Ellie
    autoPlay: 1
    maskingLines:
    - "[I\u2019m great! How are you?]"
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Also great! God, it\u2019s been so long."
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Yeah, It has\u2026"
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Hey, listen. I\u2019m actually grabbing lunch here. Do you wanna sit?"
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Actually, yeah, that\u2019d be great."
    speakerID: Ellie
    autoPlay: 0
    maskingLines:
    - "[Oh, sorry!][ I\u2019m on my way][ to another thing.]"
    - "[Maybe\u2026][I don\u2019t have][ a lot of time, though.]"
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Sweet! I\u2019ll get us a table."
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: ...
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: ...
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: 'So what brings you back here? '
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Didn't you move to Seattle or something?
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Yeah, I did. It just wasn\u2019t a fit. "
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: That's okay! It happens.
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: And you got a job out here?
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Yeah! I\u2019m just at the bookstore next door."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Oh, no way, I love that place!
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Anything you recommend?
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Oh, um...
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: I guess it just depends on what you like.
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "That\u2019s fair."
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u2026Well, I\u2019m glad to hear you\u2019re doing well!!"
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: It really is good to see you again.
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u2026"
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Actually, um\u2026"
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "I\u2019m not\u2026doing well."
    speakerID: Ellie
    autoPlay: 0
    maskingLines:
    - '[Sorry,][ nevermind.]'
    - '[I should get going.]'
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "I got fired. That\u2019s why I moved back."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: The bookstore is only part time.
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "The only reason I\u2019m even eating out at all is\u2026"
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Well\u2026it\u2019s my birthday."
    speakerID: Ellie
    autoPlay: 0
    maskingLines:
    - "[Nevermind.][ It\u2019s stupid.]"
    - "[I\u2019m just\u2026][here for lunch.]"
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: 'Oh, my God! Happy birthday! '
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Did you have any plans?
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: I wish I did.
    speakerID: Ellie
    autoPlay: 0
    maskingLines:
    - "[Yeah,][ I\u2019m throwing a party!]"
    - '[No,][ but I prefer it][ that way.]'
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Everyone I reached out to didn't respond.
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "I\u2019m not really talking to my parents right now."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "And with the news and all, I\u2019m just too scared to go out."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: This was just the one nice thing I could do for myself.
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "You have no idea how alone I\u2019ve felt."
    speakerID: Ellie
    autoPlay: 0
    maskingLines:
    - "[Sorry.][ I didn\u2019t mean][ to hog the][ conversation.]"
    - "[ I don\u2019t][ mean to][ complain.]"
    - '[I really][ appreciate you][ listening.]'
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Oh, Elena...
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: I'm so sorry.
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Here, I\u2019ll get your food. What did you order again?"
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: You don't have to do that.
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "It\u2019s your birthday! I want to."
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u2026Thank you."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: 'Of course.

'
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "You\u2019re not alone in any of this."
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: I think everyone is going through something right now.
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "And we all just\u2026not talk about it."
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: We only talk about the weather.
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: <i>God, why is it always the weather?!</i>
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: But we should definitely do something for your birthday.
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: I actually know a bakery that could make you a cake. My treat.
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: How does that sound?
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u2026Yeah. That\u2019d be great. "
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Thank you.
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
