  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 98158282d4a0937469597bd837ae0ecf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ISeeYou::ISeeYou.ConversationController
  continueInput: {fileID: 0}
  lines:
  - text: Gina?
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Ellie!
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Oh my god, hi!
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: It's so good to see you! How are you?
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Hi! I, um...
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: I'm okay. Just tired.
    speakerID: Ellie
    autoPlay: 1
    maskingLines:
    - '[I''m great!]'
    - '[Pretty good.]'
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: How are you?
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Also great! God, it\u2019s been so long."
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Yeah! Yeah, It has\u2026"
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Hey, listen. I\u2019m actually grabbing lunch here. Do you wanna sit?"
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Oh no, I\u2019m\u2026"
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Actually, yeah, that\u2019d be great."
    speakerID: Ellie
    autoPlay: 0
    maskingLines:
    - "I don\u2019t have a lot of time."
    - "Well, maybe\u2026"
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Sweet! I\u2019ll get us a table."
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: So what brings you back? I thought you moved to like Seattle or something.
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Yeah, I did. It just\u2026wasn\u2019t a fit. "
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: It happens!
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Your family's still out here?
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Uh\u2026yeah! Yeah, they aren\u2019t far."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Okay!
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: You got a job out here?
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Yeah! Yeah, I\u2019m just at the bookstore next door."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Oh, no way, I love that place!
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Yeah, it\u2019s great\u2026"
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Well, I\u2019m glad to hear you\u2019re doing so well!!"
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Whatever it is you\u2019re doing, keep it up!"
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u2026"
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Actually, um\u2026"
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "I\u2019m not\u2026doing well."
    speakerID: Ellie
    autoPlay: 0
    maskingLines:
    - I should get going.
    - "Sorry, I don\u2019t know what\u2019s gotten into me."
    - "I\u2019m not usually like this\u2026"
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "I got fired. That\u2019s why I moved back."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "The bookstore is only part time, so I\u2019m living off savings."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "The only reason I\u2019m even eating out at all is\u2026"
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Well\u2026it\u2019s my birthday."
    speakerID: Ellie
    autoPlay: 0
    maskingLines:
    - "Nevermind. It\u2019s stupid."
    - "I\u2019m just\u2026here for lunch."
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: 'Oh, my God! Happy birthday! '
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Did you have any plans?
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: I wish I did.
    speakerID: Ellie
    autoPlay: 0
    maskingLines:
    - "Yeah, I\u2019m throwing a party!"
    - No, but I prefer it that way.
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: But the people I reached out to who still live here all ghosted me.
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "My parents are still mad about Seattle, so I\u2019m not really talking
      to them right now."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "And like\u2026with the news and all, I\u2019m just too scared to go out
      anyway."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: This was just the one nice thing I could do for myself.
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "I\u2019m so tired of being alone."
    speakerID: Ellie
    autoPlay: 0
    maskingLines:
    - "Sorry. I didn\u2019t mean to hog the conversation."
    - "Sorry, I didn\u2019t mean to complain."
    - I really appreciate you listening.
    - "You have no idea how alone I\u2019ve felt."
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Oh, Elena...
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Here, I\u2019ll get your food. What did you order again?"
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "I can\u2019t ask you to do that."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "It\u2019s your birthday!"
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u2026Thank you."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: 'Of course.

'
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "You\u2019re not alone in any of this. I think everyone is going through
      something right now."
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "You\u2019re definitely not alone in any of this. I think everyone is going
      through something right now."
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "And we all just\u2026not talk about it."
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: We only talk about the weather.
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: <i>God, why is it always the weather?!</i>
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: We should definitely do something for your birthday.
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: I actually know a bakery right around the corner that could make you a
      cake. My treat.
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: How does that sound?
    speakerID: Gina
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Yeah. That\u2019d be great."
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Thank you.
    speakerID: Ellie
    autoPlay: 0
    maskingLines: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
