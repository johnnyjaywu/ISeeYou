    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - speakerID: a
    text: But every time I talk to anyone, I just can't...connect.
    thoughts: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - speakerID: a
    text: Like there's this blur that comes over me. And the one person I'm talking
