--- !u!114 &3462590240804146244
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4729068256503548971}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 98158282d4a0937469597bd837ae0ecf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: ISeeYou::ISeeYou.ConversationController
  continueInput: {fileID: 0}
  lines:
  - text: Gina?
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords:
    - Ginny?
    - Ginnifer?
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Ellie!
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Oh my god, hi!
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: It's so good to see you! How are you?
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Hi! I, um...
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: I'm great! How are you?
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords:
    - '[Oh god...][why did I say hi?]'
    - '[I''m so tired] [of this $#!+]'
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Also great! God, it\u2019s been so long."
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Yeah! Yeah, It has\u2026"
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Say, listen. I\u2019m actually grabbing lunch here. Do you wanna sit?"
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Oh no, I\u2019m\u2026"
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Yeah, actually that\u2019d be great."
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Sweet! I\u2019ll get a table."
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: So what brings you back? I thought you moved to like Seattle or something.
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Yeah, I did. It just\u2026wasn\u2019t a fit. "
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: It happens! You got a job out here?
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Uh\u2026yeah, I guess. I\u2019m just at the bookstore next door.\r\n"
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Oh, no way I love that place!
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Yeah, it\u2019s great\u2026"
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Are you still writing that novel since the last time we saw each other?
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Oh\u2026yeah. I am."
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "It\u2019s just\u2026taking a lot longer than I expected."
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Totally.
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Well, I\u2019m glad to hear you\u2019re doing so well!!"
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "And you look great! Whatever it is you\u2019re doing, keep it up!"
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "\u2026"
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Actually, um\u2026"
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Sorry. I\u2019m not usually like this\u2026"
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "I\u2019m not\u2026doing well\u2026"
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "I got fired. That\u2019s why I moved back."
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "And the bookstore is only part time, so I\u2019m mostly living off savings."
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "The only reason I\u2019m even eating out at all is\u2026"
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Well\u2026it\u2019s my birthday."
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: 'Oh, my God! Happy birthday! '
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Did you\u2026have any plans?"
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: No.
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: 'The people I reached out to who still live here all ghosted me. '
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "My parents are still mad about Seattle, so I\u2019m not really talking
      to them right now."
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "And like\u2026with the news and all, I\u2019m just scared to go out anyway."
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: This was just the one nice thing I could do for myself.
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "I\u2019m so sorry."
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "I don\u2019t usually dump on people like this."
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "I\u2019ll get going. I\u2019ll buy your coffee too. "
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Oh my God. Don\u2019t even think about it."
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: You sure?
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "It\u2019s your birthday! All of this is on me. "
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "...Thank you, Gina. \r\n"
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: 'Of course.

'
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Thank you for...being honest.
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "You\u2019re definitely not alone in any of this. I think everyone is going
      through something right now."
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "And we all just\u2026not talk about it."
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: We only talk about the weather.
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: 'Oh my God, I know! '
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: But we should definitely do something for your birthday.
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: 'I actually know a bakery right around the corner that could make you a
      cake. My treat. '
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "I can\u2019t make you do that\u2026"
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: 'I want to! '
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Is that okay?
    speakerID: Gina
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: "Yeah. That\u2019d be great."
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
  - text: Thank you.
    speakerID: Ellie
    autoPlayReverse: 0
    maskingWords: []
    voiceLine: {fileID: 0}
    triggerEvent:
      m_PersistentCalls:
        m_Calls: []
